[user]
	name = Chen-Pang He
	email = chen.pang.he@jdh8.org
[pull]
	ff = only
[init]
	defaultBranch = main
[core]
	editor = vim
[gpg]
	format = openpgp
[commit]
	gpgsign = true
[rebase]
	autoStash = true
[credential]
	helper = store
[push]
	useForceIfIncludes = true
[include]
	path = ~/.gitconfig.local
