[Unit]
Description=Great Internet Mersenne Prime Search

[Service]
Type=simple
ExecStart=/home/jdh8/build/p95v285.linux64/mprime -d
WorkingDirectory=/home/jdh8/build/p95v285.linux64
# Idle class: runs only on otherwise-free cores and yields the instant a normal-
# priority task wakes. Same policy as ../pons/scripts/idle-run.sh, expressed
# natively. Nice is cosmetic under SCHED_IDLE (htop colour only).
Nice=15
CPUSchedulingPolicy=idle
IOSchedulingClass=idle

[Install]
WantedBy=default.target
