[Unit]
Description=Shoginet - Distributed network for lishogi.org

[Service]
WorkingDirectory=/home/jdh8/src/shoginet
ExecStart=/usr/bin/node node_modules/.bin/tsx src/main.ts
PrivateTmp=true
DevicePolicy=closed
ProtectSystem=full
# Idle class: runs only on otherwise-free cores and yields the instant a normal-
# priority task wakes. Same policy as ../pons/scripts/idle-run.sh, expressed
# natively; inherited by the YaneuraOu engine subprocess. Nice is cosmetic here.
Nice=15
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
Restart=always

[Install]
WantedBy=default.target
